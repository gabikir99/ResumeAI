# Copy this file to frontend/.env. Create React App reads env files from this
# directory only, and only variables prefixed with REACT_APP_ reach the browser.
# Restart `npm start` after changes. Never commit frontend/.env.

# Flask API base URL. Defaults to http://localhost:5000 when unset.
REACT_APP_API_URL=http://localhost:5000

# Same Google OAuth client ID as GOOGLE_CLIENT_ID in the API environment.
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id
