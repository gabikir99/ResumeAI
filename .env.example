# Copy this file to .env and replace the placeholders. Never commit .env.
# The Flask app and CLI load this file from the project root.

# Required. PostgreSQL connection string.
# Local example shape: postgresql://USER:PASSWORD@localhost:5432/resume_assistant
# On Render, attach a PostgreSQL database so Render sets DATABASE_URL for you.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/resume_assistant

# Required for chat features. https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Google OAuth client ID (not the client secret). Required for Google sign-in.
# Use the same value as REACT_APP_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Required for admin routes: /api/rate-limit/reset and /api/admin/sessions.
ADMIN_KEY=your-admin-key

# Required only for POST /api/feedback. SMTP_PORT defaults to 587 when unset.
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
ADMIN_EMAIL=you@example.com

# Optional. Set to true to log SQL. Defaults to false.
SQL_ECHO=false
